{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Storage": {
    "DataDirectory": "data"
  },
  "Backup": {
    "Enabled": true,
    "IntervalHours": 24,
    "KeepCount": 14,
    "Directory": ""
  },
  "Jwt": {
    "Issuer": "Wortlet",
    "Audience": "Wortlet",
    "ExpiryDays": 30
  },
  "OpenRouter": {
    "BaseUrl": "https://openrouter.ai/api/v1",
    "Model": "google/gemma-4-31b-it:free",
    "FallbackModels": "google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-super-vl:free,openrouter/free",
    "Referer": "http://localhost:8080",
    "Title": "Vokabeltrainer",
    "TimeoutSeconds": 120
  },
  "Recognition": {
    "DailyLimitPerUser": 30,
    "MaxImageBytes": 10485760
  },
  "RateLimiting": {
    "AuthPerMinute": 20
  }
}
