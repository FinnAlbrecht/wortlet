# Kopiere diese Datei nach .env und trage deine Werte ein. .env wird NICHT ins Repository übernommen.

# OpenRouter-Schlüssel für die Bilderkennung (https://openrouter.ai/keys). Leer lassen = Fotoknopf aus, „Prompt kopieren“ geht trotzdem.
OPENROUTER_API_KEY=

# Geheimer Schlüssel für die Anmelde-Tokens, mindestens 32 Zeichen (z. B. mit: openssl rand -base64 48).
# Leer lassen = wird beim ersten Start erzeugt und im Daten-Volume gespeichert.
JWT_KEY=

# Öffentliche Adresse der App (wird an OpenRouter als HTTP-Referer geschickt)
PUBLIC_URL=http://localhost:8080

# Fotos pro Benutzer und Tag
PHOTOS_PER_DAY=30
